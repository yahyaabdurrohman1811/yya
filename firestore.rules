rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidNumber(val, minVal, maxVal) {
      return (val is number || val is int || val is float) && val >= minVal && val <= maxVal;
    }

    // Vessels Collection
    match /vessels/{vesselId} {
      allow read: if true;
      allow create, update: if isAuthenticated() &&
        isValidString(request.resource.data.name, 2, 100) &&
        isValidString(request.resource.data.imoNumber, 3, 30);
      allow delete: if isAuthenticated();
    }

    // Voyages Collection
    match /voyages/{voyageId} {
      allow read: if true;
      allow create, update: if isAuthenticated() &&
        isValidString(request.resource.data.voyageNumber, 2, 50);
      allow delete: if isAuthenticated();
    }

    // Cargo Collection
    match /cargos/{cargoId} {
      allow read: if true;
      allow create, update: if isAuthenticated() &&
        isValidString(request.resource.data.blNumber, 2, 50);
      allow delete: if isAuthenticated();
    }

    // Crew Collection
    match /crews/{crewId} {
      allow read: if true;
      allow create, update: if isAuthenticated() &&
        isValidString(request.resource.data.fullName, 2, 100);
      allow delete: if isAuthenticated();
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
