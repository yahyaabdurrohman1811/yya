rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // Vessels Collection
    match /vessels/{vesselId} {
      allow read, write: if true;
    }

    // Voyages Collection
    match /voyages/{voyageId} {
      allow read, write: if true;
    }

    // Cargo Collection
    match /cargos/{cargoId} {
      allow read, write: if true;
    }

    // Crew Collection
    match /crews/{crewId} {
      allow read, write: if true;
    }

    // App Users / Active Admin Profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // App Sessions
    match /sessions/{sessionId} {
      allow read, write: if true;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
